diff --git a/Tests/Utils/FileUtilsTest.cs b/Tests/Utils/FileUtilsTest.cs
index d8efd1c..018728e 100644
--- a/Tests/Utils/FileUtilsTest.cs
+++ b/Tests/Utils/FileUtilsTest.cs
@@ -3,0 +4,25 @@ public class FileUtilsTest : TestWithFolder {
+    #region 写入
+
+    [Test]
+    public async Task 原子写入_并发创建同一文件() {
+        const int writerCount = 16;
+        string output = Path.Combine(tempFolder, "config.json");
+        using var ready = new CountdownEvent(writerCount);
+        using var start = new ManualResetEventSlim(false);
+        Task[] writers = Enumerable.Range(0, writerCount).Select(index => Task.Run(() => {
+            ready.Signal();
+            start.Wait();
+            FileUtils.WriteAtomic(output, $"{{\"writer\":{index}}}");
+        })).ToArray();
+
+        ready.Wait();
+        start.Set();
+        await Task.WhenAll(writers);
+
+        Newtonsoft.Json.Linq.JObject result = FileUtils.ReadAsJson<Newtonsoft.Json.Linq.JObject>(output)!;
+        await Assert.That(result.Value<int>("writer")).IsBetween(0, writerCount - 1);
+        await Assert.That(DirectoryUtils.EnumerateFiles(tempFolder, searchPattern: "config.json.*.tmp")).IsEmpty();
+    }
+
+    #endregion
