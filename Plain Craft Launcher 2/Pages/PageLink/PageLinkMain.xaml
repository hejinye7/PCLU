<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageLinkMain"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10" MaxWidth="700">
            <local:MyCard x:Name="PanSelectCreate" Margin="0,15,0,15" CornerRadius="13">
                <Grid IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="25" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                    </Grid.RowDefinitions>
                    <Path Grid.Column="1" Grid.Row="1" Height="26" Width="26" Margin="0,-1,0,0"
                          Stretch="Uniform" Fill="{DynamicResource ColorBrush3}"
                          Data="M384 128v192h256a64 64 0 0 1 64 64v256h192V128H384zM320 320V128a64 64 0 0 1 64-64h512a64 64 0 0 1 64 64v512a64 64 0 0 1-64 64h-192v192a64 64 0 0 1-64 64H128a64 64 0 0 1-64-64V384a64 64 0 0 1 64-64h192z m320 384H384a64 64 0 0 1-64-64V384H128v512h512v-192z m0-64V384H384v256h256z" />
                    <TextBlock Grid.Column="3" Grid.Row="1" Text="创建房间" FontSize="20" Foreground="{DynamicResource ColorBrush3}" />
                    <TextBlock Grid.Column="3" Grid.Row="2" Margin="1,10,0,10" FontSize="15" LineHeight="19"
                               Text="先在游戏中对局域网开放，再点击这里创建陶瓦房间。" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                </Grid>
            </local:MyCard>

            <local:MyCard x:Name="PanSelectJoin" Margin="0,0,0,15" CornerRadius="13">
                <Grid IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="25" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                    </Grid.RowDefinitions>
                    <Path Grid.Column="1" Grid.Row="1" Height="26" Width="26" Margin="0,-1,0,0"
                          Stretch="Uniform" Fill="{DynamicResource ColorBrush3}"
                          Data="m399,355l-92.5,101.6c-13.7,13.7-10.6,36.4,4.6,47,13.7,9.1,30.3,7.6,41-4.5l127.4-138.1c16.7-18.2,18.2-47,0-66.8l-125.9-141.1c-12.1-13.7-34.9-15.2-47,0-12.1,12.1-12.1,31.9,0,44l92.5,98.6H28.8c-16.7,0-28.8,13.7-28.8,28.8s13.7,28.8,28.8,28.8h370.2v1.5ZM625.7,0H224.6c-44,0-78.9,34.9-78.9,78.9v101.6c0,15.2,12.1,27.3,27.3,27.3s27.3-12.1,27.3-27.3v-98.6c0-15.2,12.1-27.3,27.3-27.3h387.5c15.2,0,27.3,12.1,27.3,27.3v493c0,15.2-12.1,27.3-27.3,27.3H229.2c-15.2,0-27.3-12.1-27.3-27.3v-101.6c0-16.7-13.7-28.8-28.8-28.8s-28.8,13.7-28.8,28.8v98.6c0,44,34.9,78.9,78.9,78.9h407.2c44,0,67.9-34.9,67.9-78.9V78.9c-4.6-44-28.4-78.9-72.4-78.9Z" />
                    <TextBlock Grid.Column="3" Grid.Row="1" Text="加入房间" FontSize="20" Foreground="{DynamicResource ColorBrush3}" />
                    <TextBlock Grid.Column="3" Grid.Row="2" Margin="1,10,0,10" FontSize="15" LineHeight="19"
                               Text="输入好友发来的陶瓦房间码，加入对方的游戏。" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                </Grid>
            </local:MyCard>

            <local:MyCard Title="联机状态" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock x:Name="LabStatus" Text="正在检查陶瓦状态..." TextWrapping="Wrap" FontSize="14" LineHeight="20" />
                    <local:MyTextBox x:Name="TextRoom" Visibility="Collapsed" />
                    <TextBlock Text="连接成功后，在游戏的多人游戏列表中进入“陶瓦联机大厅”。" TextWrapping="Wrap"
                               Foreground="{StaticResource ColorBrushGray3}" Margin="0,9,0,0" />
                    <local:MyTextButton Text="»  Terracotta 项目与许可" FontSize="12" Margin="0,9,0,0"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/burningtnt/Terracotta" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardManage" Title="管理陶瓦" Margin="0,0,0,15" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="20,37,20,12">
                    <local:MyListItem x:Name="BtnCopy" Title="复制房间码" Info="复制当前创建或加入的房间码" Height="42" />
                    <local:MyListItem x:Name="BtnReset" Title="复位联机" Info="退出当前房间并回到空闲状态" Height="42" />
                    <local:MyListItem x:Name="BtnInstall" Title="安装或更新陶瓦" Info="下载并校验 Terracotta 0.4.2" Height="42" />
                    <local:MyListItem x:Name="BtnStop" Title="关闭陶瓦" Info="结束后台联机进程并断开连接" Height="42" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
