<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    mc:Ignorable="d" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="游戏文件修复">
                <Grid Margin="25,40,25,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock x:Name="LabRepairTitle" FontSize="14" Text="当前未选择游戏版本" />
                        <TextBlock Margin="0,5,0,0" Opacity="0.55" TextWrapping="Wrap" Text="校验主文件、支持库和资源文件，只重新下载缺失或损坏的内容。" />
                    </StackPanel>
                    <local:MyButton x:Name="BtnRepair" Grid.Column="1" MinWidth="130" Height="35" Text="开始修复" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="安全缓存清理">
                <Grid Margin="25,40,25,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock FontSize="14" Text="清理下载残片与临时缓存" />
                        <TextBlock Margin="0,5,0,0" Opacity="0.55" TextWrapping="Wrap" Text="清理前显示文件数量和占用空间，不会删除存档、Mod、整合包或游戏设置。" />
                    </StackPanel>
                    <local:MyButton x:Name="BtnCacheClear" Grid.Column="1" MinWidth="130" Height="35" Text="扫描并清理" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="Eclipse Temurin JDK">
                <Grid Margin="25,40,25,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock FontSize="14" Text="一键安装 Minecraft 常用 JDK" />
                        <TextBlock x:Name="LabTemurinStatus" Margin="0,5,0,0" Opacity="0.55" TextWrapping="Wrap" Text="从 Adoptium 官方获取 Temurin JDK 8、11、17、21、25，全程静默安装并自动加入 PCL Java 列表。" />
                    </StackPanel>
                    <local:MyButton x:Name="BtnTemurinInstall" Grid.Column="1" MinWidth="150" Height="35" Text="安装全部 JDK" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="U 盘便携安装">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock FontSize="14" Text="把游戏和启动器安装到 U 盘根目录" />
                    <TextBlock Margin="0,5,0,14" Opacity="0.55" TextWrapping="Wrap" Text="支持批量实例便携启动器，或当前实例单独 BAT。会生成 .minecraft 和启动脚本；离线账号可随包使用，正版账号不会复制令牌，需要在目标设备重新登录。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <local:MyComboBox x:Name="ComboUsbMode" Grid.Column="0" Height="34" VerticalAlignment="Top" />
                        <TextBlock x:Name="LabUsbTarget" Grid.Column="2" VerticalAlignment="Center" Opacity="0.55" Text="尚未选择 U 盘根目录" TextWrapping="Wrap" />
                        <local:MyButton x:Name="BtnUsbSelect" Grid.Column="4" Height="35" Text="选择 U 盘" />
                    </Grid>
                    <StackPanel x:Name="PanUsbInstances" Margin="0,12,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabUsbStatus" VerticalAlignment="Center" Opacity="0.55" Text="请选择目标 U 盘。" TextWrapping="Wrap" />
                        <local:MyButton x:Name="BtnUsbExport" Grid.Column="1" MinWidth="150" Height="35" Text="开始安装到 U 盘" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
