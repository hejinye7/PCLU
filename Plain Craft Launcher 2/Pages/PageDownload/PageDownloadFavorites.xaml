<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageDownloadFavorites"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10,25,25">
            <local:MyCard Title="收藏夹" Margin="0,0,0,15">
                <StackPanel Margin="20,40,20,18">
                    <Grid Height="35">
                        <TextBlock x:Name="LabFavoriteCount" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray2}" />
                        <local:MyIconButton x:Name="BtnRefreshFavorites" HorizontalAlignment="Right" Width="30" Height="30" ToolTip="刷新" LogoScale="0.85" Logo="M512 838c-80-0-153-29-210-77l76-76c11-11 26-22 26-37a27 27 0 0 0-27-27H104c-27 0-27 24-27 27v272a27 27 0 0 0 27 27c15 0 28-17 43-31l78-78c77 68 177 109 287 109 222 0 405-166 431-381H833c-26 154-160 272-321 272zM920 77c-15 0-28 17-43 31l-78 78c-77-68-177-109-287-109-222 0-405 166-431 381h110c26-154 160-272 321-272 80 0 153 29 210 77l-76 76c-12 12-26 22-26 37a27 27 0 0 0 27 27h272c27 0 27-24 27-27V104a27 27 0 0 0-27-27z" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyHint x:Name="HintEmptyFavorites" Text="还没有收藏社区资源。点击资源列表右侧的星标即可收藏。" Theme="Blue" Margin="0,0,0,15" />
            <local:MyCard x:Name="CardFavorites" UseAnimation="False">
                <StackPanel x:Name="PanFavorites" Margin="12" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
